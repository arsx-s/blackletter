# OpenRouter API key. Server-side only: the Vercel function (api/chat.ts) and the
# local relay (scripts/dev-server.mjs) read it from process.env. The browser
# never has access to this value, and the client never sends it.
OPENROUTER_API_KEY=your_openrouter_key_here

# ---------------------------------------------------------------------------
# Relay access control
# ---------------------------------------------------------------------------
# Required by the hosted relay. When set, every request must carry
# `Authorization: Bearer <value>`. The local loopback relay may omit it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then paste the same value into Workshop → AI & Models → Model relay access.
# BLACKLETTER_RELAY_TOKEN=

# Extra browser origins allowed to call the relay (comma separated). The
# defaults already cover the Vite dev (5173) and preview (4173) servers.
# BLACKLETTER_ALLOWED_ORIGINS=https://your-deployment.example.com

# On the hosted profile, requests with no Origin header are refused because
# Origin is the only browser-side signal available. Opt out only if a
# non-browser client must call a relay you have already secured with a token.
# BLACKLETTER_RELAY_ALLOW_NO_ORIGIN=1

# ---------------------------------------------------------------------------
# Model policy
# ---------------------------------------------------------------------------
# Provider prefixes the relay will forward to. A model id outside this set is
# refused with MODEL_NOT_ALLOWED instead of being passed upstream.
# BLACKLETTER_ALLOWED_MODEL_PREFIXES=openai,anthropic,google,deepseek

# Additional exact model ids to allow beyond the prefixes above.
# BLACKLETTER_ALLOWED_MODELS=some-vendor/some-model

# Forward any syntactically valid model id. Off by default: an unauthenticated
# relay that accepts arbitrary ids is an unbounded-spend vector.
# BLACKLETTER_ALLOW_ANY_MODEL=1

# Default model when a request omits one. BLACKLETTER_DEFAULT_MODEL wins over
# the legacy DEFAULT_MODEL name; both are honoured.
# DEFAULT_MODEL=openai/gpt-4o-mini
# BLACKLETTER_DEFAULT_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Local relay
# ---------------------------------------------------------------------------
# The local relay binds to loopback only. Change this deliberately and only on
# a machine you control; it holds the provider credential.
# BLACKLETTER_DEV_HOST=127.0.0.1
# BLACKLETTER_DEV_PORT=3000

# Per-client token bucket, per process. Bounds cost; not a quota system.
# BLACKLETTER_RATE_PER_MINUTE=20
# BLACKLETTER_RATE_BURST=6
