# OpenRouter API key (configured server-side in Vercel Environment Variables)
# The browser never has access to this key.
# The Vercel serverless function (api/chat.ts) reads it from process.env on the server.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional model defaults (see src/config/models.ts)
# DEFAULT_MODEL=openai/gpt-4o-mini